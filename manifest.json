{
    "name": "Wingman/Synapse",
    "version": "1.0.0",
    "type": "library",
    "description": "A dependency injection container for the Wingman framework with scoped lifetimes, contextual bindings, provider orchestration, and optional PSR-11 bridge compatibility.",
    "authors": [
        {
            "name": "Angel Politis",
            "email": "info@angelpolitis.com"
        }
    ],
    "license": "MPL-2.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/angelpolitis/Wingman-Synapse.git"
    },
    "homepage": "https://github.com/angelpolitis/Wingman-Synapse",
    "php": ">=8.1",
    "dependencies": [
        {
            "package": "Wingman/Argus",
            "version": ">=1.0",
            "optional": true
        }
    ],
    "autoload": {
        "psr-4": {
            "Wingman.Synapse.": "src/",
            "Wingman.Synapse.Tests.": "tests/"
        }
    }
}